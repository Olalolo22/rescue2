# Solana Base Layer
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# MagicBlock ER / PER Devnet Endpoints
MB_ER_RPC_URL=https://devnet.magicblock.app
MB_TEE_RPC_URL=https://devnet-tee.magicblock.app
MB_TEE_WS_URL=wss://devnet-as.magicblock.app

# Current Verified MagicBlock TEE Validator Identity (Verify via getIdentity RPC)
TEE_VALIDATOR_DEVNET=MTEWGuqxUpYZGFJQcp8tLN7x5v9BSeoFHYWQQ3n3xzo

# Target Deployed Probe Program ID (Update after 'anchor deploy' or 'solana program deploy')
PROBE_PROGRAM_ID=Probe11111111111111111111111111111111111111

# Keypair file paths (generate via `solana-keygen new -o <path>` or leave empty for auto-generated ephemeral keypairs)
AUTHORITY_KEYPAIR_PATH=~/.config/solana/id.json
STRANGER_KEYPAIR_PATH=

# Pyth Devnet Feed Account (PriceUpdateV2 for SOL/USD on Solana Devnet)
